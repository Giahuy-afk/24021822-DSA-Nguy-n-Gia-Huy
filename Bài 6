#include <iostream>
#include <vector>

using namespace std;


void xoaPhanTu(vector<int>& a, int k) {
    int n = a.size();
    if (k < 0 || k >= n) {
        cout << "Vi tri k khong hop le!" << endl;
        return;
    }
    a.erase(a.begin() + k);
}


void chenPhanTu(vector<int>& a, int y, int m) {
    int n = a.size();
    if (m < 0 || m > n) {
        cout << "Vi tri m khong hop le!" << endl;
        return;
    }
    a.insert(a.begin() + m, y);
}

void inMang(const vector<int>& a) {
    for (int x : a) cout << x << " ";
    cout << endl;
}

int main() {
    int n;
    cout << "Nhap N: ";
    cin >> n;

    vector<int> a(n);
    cout << "Nhap " << n << " phan tu: ";
    for (int i = 0; i < n; i++) cin >> a[i];

    
    int k;
    cout << "Nhap vi tri k can xoa (0-indexed): ";
    cin >> k;
    xoaPhanTu(a, k);
    cout << "Day sau khi xoa: ";
    inMang(a);

  
    int y, m;
    cout << "Nhap gia tri y va vi tri m can chen: ";
    cin >> y >> m;
    chenPhanTu(a, y, m);
    cout << "Day sau khi chen: ";
    inMang(a);

    return 0;
}
