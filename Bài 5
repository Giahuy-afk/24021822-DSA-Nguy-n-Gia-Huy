#include <iostream>
#include <vector>

using namespace std;

int main() {
    int n;
    cout << "Nhap N: ";
    cin >> n;

    vector<double> a(n);
    double sum = 0;

    cout << "Nhap " << n << " so thuc: ";
    for (int i = 0; i < n; i++) {
        cin >> a[i];
        sum += a[i];
    }

    double tbr = sum / n;
    cout << "Gia tri trung binh: " << tbr << endl;
    cout << "Cac phan tu lon hon hoac bang trung binh: ";

    for (int i = 0; i < n; i++) {
        if (a[i] >= tbr) {
            cout << a[i] << " ";
        }
    }
    cout << endl;

    return 0;
}
