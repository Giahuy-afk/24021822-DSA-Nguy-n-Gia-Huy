#include <iostream>
#include <vector>

using namespace std;

int main() {
    int n;
    cout << "Nhap N: ";
    cin >> n;

    vector<long long> a(n);
    long long sum = 0;

    cout << "Nhap " << n << " phan tu: ";
    for (int i = 0; i < n; i++) {
        cin >> a[i];
        sum += a[i];
    }

    cout << "Tong cac phan tu trong day: " << sum << endl;
    return 0;
}
